@model SignInInput
@{ ViewData["Title"] = "Sign in"; }
<h1>Sign in</h1><p>Use your assigned CivicConnect account.</p>
<form class="panel narrow" method="post" action="/account/sign-in">
@Html.AntiForgeryToken()<div asp-validation-summary="All" class="errors" role="alert" tabindex="0"></div>
<input asp-for="ReturnUrl" type="hidden">
<div class="field"><label asp-for="Username">Username</label><input asp-for="Username" autocomplete="username" required maxlength="100"><span asp-validation-for="Username"></span></div>
<div class="field"><label for="Password">Password</label><input id="Password" name="Password" type="password" autocomplete="current-password" required maxlength="1024"><span asp-validation-for="Password"></span></div>
<button type="submit">Sign in</button></form>
