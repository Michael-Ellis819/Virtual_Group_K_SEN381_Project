<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] · CivicConnect</title>
<style>
:root{font:16px/1.6 system-ui,sans-serif;color:#182b3a;background:#f4f6f8}*{box-sizing:border-box}body{margin:0}a{color:#075a9c;text-underline-offset:3px}a:hover{text-decoration-thickness:2px}:focus-visible{outline:3px solid #a64e00;outline-offset:3px}.skip{position:absolute;left:-10000px}.skip:focus{left:1rem;top:1rem;background:white;padding:1rem;z-index:5}header{background:#143b53;color:white;padding:1rem max(1rem,calc((100% - 1100px)/2))}header a{color:white}.brand{font-size:1.4rem;font-weight:750;text-decoration:none}nav{display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:.5rem}nav form{margin:0}main{max-width:1100px;margin:2rem auto;padding:0 1rem;min-height:65vh}h1,h2,h3{line-height:1.2;color:#143b53}h1{overflow-wrap:anywhere;font-size:clamp(1.8rem,5vw,2.6rem)}h2{font-size:1.35rem;margin-top:1.7rem}p{max-width:75ch}.muted{color:#4e6370}.panel{background:white;border:1px solid #cbd5dd;border-radius:.5rem;padding:1.25rem;margin:1rem 0}.narrow{max-width:38rem}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:1rem}.field{margin:0 0 1rem}label{display:block;font-weight:650;margin-bottom:.25rem}input,select,textarea,button{font:inherit;max-width:100%}input,select,textarea{width:100%;border:1px solid #6b7e89;border-radius:.25rem;padding:.6rem;background:white;color:#182b3a}textarea{min-height:8rem;resize:vertical}input[type=checkbox]{width:auto}button,.button{display:inline-block;border:1px solid #075a9c;border-radius:.25rem;background:#075a9c;color:white;padding:.6rem 1rem;text-decoration:none;cursor:pointer}button:hover,.button:hover{background:#064578}button.secondary{background:transparent;color:inherit;border-color:currentColor}.actions{display:flex;gap:1rem;flex-wrap:wrap;align-items:center}.errors,.field-validation-error{color:#8d1b18}.validation-summary-valid,.field-validation-valid{display:none}.errors{border-left:4px solid #b52c25;background:#fff3f1;padding:.8rem 1rem;margin-bottom:1rem}.notice{border-left:4px solid #9b5e0b;background:#fff8e9;padding:1rem}.requests{list-style:none;padding:0}.requests li{margin:1rem 0}.request-head{display:flex;justify-content:space-between;gap:.7rem;flex-wrap:wrap}.badge{background:#edf2f6;border-radius:.3rem;padding:.1rem .5rem}dl{display:grid;grid-template-columns:minmax(7rem,1fr) minmax(0,3fr);gap:.4rem 1rem}dt{font-weight:650}dd{margin:0;overflow-wrap:anywhere}.content{white-space:pre-wrap;overflow-wrap:anywhere}.counts strong{font-size:2.2rem;display:block}.note{border-bottom:1px solid #dbe2e8;padding:.8rem 0}.note:last-child{border:0}footer{max-width:1100px;margin:auto;padding:1rem;color:#4e6370}small{display:block}fieldset{border:1px solid #cbd5dd;padding:1rem;min-width:0}legend{font-weight:650}@@media(max-width:480px){main{margin:1rem auto}.panel{padding:1rem}dl{display:block}dd{margin-bottom:.8rem}h1{overflow-wrap:anywhere}}
</style></head>
<body><a class="skip" href="#main">Skip to main content</a>
<header><a class="brand" href="/">CivicConnect</a><nav aria-label="Main navigation">
@if (User.Identity?.IsAuthenticated == true) {
    @if (User.IsInRole("Requester") || User.IsInRole("Staff")) { <a href="/portal/requests">Requests</a> }
    @if (User.IsInRole("Requester")) { <a href="/portal/requests/new">Submit a request</a> }
    @if (User.IsInRole("Management")) { <a href="/portal/management">Service overview</a> }
    <form action="/account/sign-out" method="post">@Html.AntiForgeryToken()<button class="secondary" type="submit">Sign out</button></form>
} else { <a href="/account/sign-in">Sign in</a> }
</nav></header><main id="main" tabindex="-1">@RenderBody()</main><footer>CivicConnect · Community service requests</footer></body></html>
