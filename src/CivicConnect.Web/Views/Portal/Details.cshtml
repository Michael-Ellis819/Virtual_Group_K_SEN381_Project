@model DetailPage
@{ ViewData["Title"] = Model.Request.ReferenceNumber; }
<a href="/portal/requests">Back to requests</a><h1>Request @Model.Request.ReferenceNumber</h1>
<div class="panel"><dl><dt>Status</dt><dd>@Model.Request.Status</dd><dt>Updated (UTC)</dt><dd>@Model.Request.UpdatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</dd><dt>Category</dt><dd>@Model.Request.CategoryId</dd><dt>Location</dt><dd>@Model.Request.Location</dd>
@if (Model.Metadata is { } metadata) {
    @if (metadata.CreatedAt is { } created) { <dt>Submitted (UTC)</dt><dd>@created.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</dd> }
    @if (Model.CanChange) { <dt>Requester</dt><dd>@metadata.Requester</dd> }
    <dt>Priority</dt><dd>@metadata.Priority</dd><dt>Owner</dt><dd>@(metadata.OwnerId ?? "Unassigned")</dd><dt>Due (UTC)</dt><dd>@(metadata.DueAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "No due date")</dd>
}</dl><h2>Description</h2><p class="content">@Model.Request.Description</p></div>
<section class="panel" aria-labelledby="updates"><h2 id="updates">@(Model.CanChange ? "Updates and notes" : "Updates")</h2>
@if (Model.Metadata is { } notesMetadata) { @foreach (var note in notesMetadata.Notes) { <article class="note"><p class="content">@note.Content</p><small>@note.Author · @note.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC @(Model.CanChange ? (note.IsPublic ? "· Public update" : "· Internal note") : "")</small></article> } }
else { @foreach (var note in Model.Request.Notes) { <p class="content note">@note</p> } }
@if (Model.Request.Notes.Count == 0 && (Model.Metadata?.Notes.Count ?? 0) == 0) { <p>No updates yet.</p> }</section>
@if (Model.CanChange) {
    @if (Model.Request.Status == "New") { <form class="panel narrow" method="post" action="/portal/requests/@Model.Request.RequestId/assign">@Html.AntiForgeryToken()<h2>Assign an owner</h2><input name="ExpectedVersion" type="hidden" value="@Model.Version"><div class="field"><label for="OwnerId">Staff account ID</label><input id="OwnerId" name="OwnerId" required maxlength="100" aria-describedby="owner-help"><small id="owner-help">The owner must be active and authorised for this category.</small></div><button type="submit">Assign request</button></form>
        <form class="panel narrow" method="post" action="/portal/requests/@Model.Request.RequestId/assign">@Html.AntiForgeryToken()<input name="ExpectedVersion" type="hidden" value="@Model.Version"><input name="OwnerId" type="hidden" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value"><button type="submit">Claim this request</button></form> }
    @if (Model.NextStatuses.Count > 0) { <form class="panel narrow" method="post" action="/portal/requests/@Model.Request.RequestId/status">@Html.AntiForgeryToken()<h2>Update status</h2><input type="hidden" name="ExpectedStatus" value="@Model.Request.Status"><div class="field"><label for="TargetStatus">Next status</label><select id="TargetStatus" name="TargetStatus" required>@foreach (var status in Model.NextStatuses) { <option value="@status">@status</option> }</select></div><div class="field"><label for="Feedback">Public feedback or resolution summary</label><textarea id="Feedback" name="Feedback" required maxlength="2000" aria-describedby="feedback-help"></textarea><small id="feedback-help">Visible to the requester. A rejection reason or resolution summary is required.</small></div><button type="submit">Save status</button></form> }
    <form class="panel narrow" method="post" action="/portal/requests/@Model.Request.RequestId/notes">@Html.AntiForgeryToken()<h2>Add a note</h2><input name="ExpectedVersion" type="hidden" value="@Model.Version"><div class="field"><label for="Content">Note</label><textarea id="Content" name="Content" required maxlength="2000"></textarea></div><div class="field"><label><input type="checkbox" name="IsPublic" value="true"> Share with the requester</label><small>Leave unchecked for an internal staff note.</small></div><button type="submit">Save note</button></form>
    <form class="panel narrow" method="post" action="/portal/requests/@Model.Request.RequestId/schedule">@Html.AntiForgeryToken()<h2>Priority and due date</h2><input name="ExpectedVersion" type="hidden" value="@Model.Version"><div class="field"><label for="Priority">Priority</label><select id="Priority" name="Priority" required>@foreach (var priority in PortalOptions.Priorities) { <option value="@priority" selected="@(Model.Metadata?.Priority == priority)">@priority</option> }</select></div><div class="field"><label for="DueAt">Due date and time (UTC)</label><input id="DueAt" name="DueAt" type="datetime-local" value="@Model.Metadata?.DueAt?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm")"><small>Leave blank for no due date.</small></div><button type="submit">Save priority and due date</button></form>

}
@if (Model.Metadata is { } historyMetadata && historyMetadata.History.Count > 0) { <section class="panel"><h2>Request history</h2>@foreach (var item in historyMetadata.History) { <p>@item.Action · @item.Actor · @item.At.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC</p> }</section> }
